# ============================================
# ONIKAANIME - ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ
# ============================================

# Порт для сервера
PORT=3000

# Подключение к PostgreSQL
# Формат: postgresql://username:password@host:port/database
# Если у вас стандартная установка PostgreSQL:
# - username: postgres
# - password: (пароль, который вы установили при установке PostgreSQL)
# - host: localhost
# - port: 5432 (стандартный)
# - database: onikaanime (название базы данных)

# ВАЖНО: Замените 'your_password' на ваш реальный пароль PostgreSQL!
# Если вы не меняли пароль при установке, возможно он пустой или 'postgres'
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/onikaanime

# Режим работы (development/production)
NODE_ENV=development

# Настройки безопасности
# Соль для bcrypt (10-12 рекомендуется)
# 10 - оптимально для производительности
BCRYPT_SALT_ROUNDS=10

# Настройки кэширования (время в секундах)
# 300 = 5 минут
CACHE_TTL=300

# API ключи (если потребуются)
# ANILIBRIA_API_KEY=your_key_here
# SHIKIMORI_API_KEY=your_key_here
# KODIK_API_KEY=your_key_here
